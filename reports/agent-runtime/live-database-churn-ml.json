          "sql": "SELECT\n  a.account_id,\n  CASE WHEN s.status = 'cancelled' THEN 1 ELSE 0 END AS churn,\n  (DATE '2025-06-30' - a.created_at::date) AS tenure_days,\n  COALESCE(SUM(CASE WHEN u.usage_date >= DATE '2025-06-17' THEN u.active_events ELSE 0 END), 0) AS usage_recent,\n  COALESCE(SUM(CASE WHEN u.usage_date < DATE '2025-06-17' THEN u.active_events ELSE 0 END), 0) AS usage_prior,\n  COUNT(t.account_id) AS ticket_count,\n  COUNT(CASE WHEN t.severity = 'high' THEN 1 END) AS high_tickets,\n  a.plan,\n  a.region\nFROM live_analysis_churn_ml_8dbc268b59734568be1c4d53.accounts a\nLEFT JOIN live_analysis_churn_ml_8dbc268b59734568be1c4d53.subscriptions s ON s.account_id = a.account_id\nLEFT JOIN live_analysis_churn_ml_8dbc268b59734568be1c4d53.usage_daily u ON u.account_id = a.account_id\nLEFT JOIN live_analysis_churn_ml_8dbc268b59734568be1c4d53.support_tickets t ON t.account_id = a.account_id\nGROUP BY a.account_id, a.plan, a.region, a.created_at, s.status"
