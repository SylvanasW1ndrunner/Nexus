{
  "name": "schemanaut",
  "version": "0.1.0",
  "private": true,
  "description": "SchemaNaut — an embeddable AI database agent runtime for natural-language SQL, governance and operations.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SylvanasW1ndrunner/Nexus.git"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm build:server && node apps/server/dist/cli.js",
    "start": "node apps/server/dist/cli.js",
    "build:server": "node scripts/clean-public-build.mjs && tsc -b packages/shared packages/core-usage packages/core-llm packages/core-resource packages/core-db packages/core-rag packages/core-skills packages/core-agent packages/core-tools packages/sdk apps/server",
    "test:server": "vitest run packages/sdk apps/server --pool=forks",
    "test:llm-platform": "vitest run packages/core-llm packages/sdk apps/server --pool=forks",
    "test:llm-platform:contracts": "vitest run packages/core-llm/test/contracts --pool=forks",
    "test:llm-platform:entrypoints": "vitest run packages/core-llm/test/entrypoints --pool=forks",
    "test:llm-platform:faults": "vitest run packages/core-llm/test/fault-injection --pool=forks",
    "test:llm-platform:security": "vitest run packages/core-llm/test/security --pool=forks",
    "test:llm-platform:performance": "pnpm build:server && node scripts/run-llm-platform-benchmark.mjs",
    "test:database-platform": "vitest run packages/shared packages/core-resource packages/core-db packages/sdk apps/server --pool=forks",
    "test:database-platform:contracts": "vitest run packages/core-resource packages/core-db/test/capability-resolver.test.ts packages/core-db/test/connector-registry.test.ts packages/core-db/test/connector-scenarios.test.ts packages/core-db/test/database-access-runtime.test.ts apps/server/test/server.test.ts --pool=forks",
    "test:database-platform:performance": "pnpm build:server && node --expose-gc scripts/run-database-access-benchmark.mjs",
    "test:public-contracts": "vitest run packages/shared --pool=forks",
    "test:public-contracts:compatibility": "vitest run packages/shared/test/contract-compatibility.test.ts --pool=forks",
    "test:public-contracts:performance": "pnpm build:server && node scripts/run-public-contracts-benchmark.mjs",
    "test:resource-state": "vitest run packages/core-resource --pool=forks",
    "test:resource-state:performance": "pnpm build:server && node --expose-gc scripts/run-resource-state-benchmark.mjs",
    "test:ai-sql": "vitest run packages/core-rag packages/core-agent packages/core-skills packages/core-tools packages/sdk --pool=forks",
    "test:ai-sql:performance": "pnpm build:server && node --expose-gc scripts/run-ai-sql-benchmark.mjs && node --expose-gc scripts/run-context-compaction-benchmark.mjs",
    "test:ai-sql:context-performance": "pnpm build:server && node --expose-gc scripts/run-context-compaction-benchmark.mjs",
    "test:ai-sql:live": "pnpm build:server && node scripts/run-postgres-tests.mjs --live-llm",
    "test:ai-sql:context-live": "pnpm build:server && node scripts/run-context-compaction-live-test.mjs",
    "test:npm-package:functional": "pnpm package:npm && node scripts/verify-npm-package.mjs",
    "test:functional:live": "pnpm build:server && node scripts/run-postgres-tests.mjs --live-llm",
    "test:performance:live": "pnpm build:server && node scripts/run-llm-live-performance.mjs",
    "package:npm": "node scripts/clean-public-build.mjs && tsc -b packages/shared packages/core-usage packages/core-llm packages/core-resource packages/core-db packages/core-rag packages/core-skills packages/core-agent packages/core-tools packages/sdk apps/server && node scripts/package-npm.mjs",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:postgres": "pnpm build:server && node scripts/run-postgres-tests.mjs",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:llm-platform:performance && pnpm test:database-platform:performance && pnpm test:public-contracts:performance && pnpm test:resource-state:performance && pnpm test:ai-sql:performance && pnpm test:npm-package:functional",
    "db:up": "docker compose -f scripts/dev-db/docker-compose.yml up -d",
    "db:down": "docker compose -f scripts/dev-db/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
