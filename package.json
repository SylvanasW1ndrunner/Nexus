{
  "name": "dbagent",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-native database IDE for data engineers.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@dbagent/desktop",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:postgres": "node scripts/run-postgres-tests.mjs",
    "test:agent-rag-live": "node scripts/run-agent-rag-live-tests.mjs",
    "smoke": "node scripts/smoke.mjs",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm smoke",
    "package": "pnpm build && pnpm --filter @dbagent/desktop package",
    "package:dir": "pnpm build && pnpm --filter @dbagent/desktop package:dir",
    "package:win": "pnpm build && pnpm --filter @dbagent/desktop package -- --win",
    "package:mac": "pnpm build && pnpm --filter @dbagent/desktop package -- --mac",
    "package:linux": "pnpm build && pnpm --filter @dbagent/desktop package -- --linux",
    "package:all": "pnpm build && pnpm --filter @dbagent/desktop package -- --win --mac --linux",
    "package:verify": "node scripts/verify-package.mjs",
    "package:verify:asar": "node scripts/verify-package.mjs --skip-launch",
    "db:up": "docker compose -f scripts/dev-db/docker-compose.yml up -d",
    "db:down": "docker compose -f scripts/dev-db/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
