{
  "name": "schemanaut",
  "version": "0.1.0-alpha.3",
  "private": true,
  "description": "SchemaNaut — an internal Agent runtime and terminal with dynamic capabilities, tools, Skills, MCP, and a first-party database capability.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SylvanasW1ndrunner/Nexus.git"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm build:terminal && node apps/terminal/dist/cli.js chat",
    "start": "node apps/terminal/dist/cli.js chat",
    "package:npm": "node scripts/release-local.mjs --package-only",
    "verify:npm-package": "node scripts/verify-npm-package.mjs",
    "test:npm-package:contracts": "node --test scripts/tests/npm-package-contract.test.mjs",
    "release:local": "node scripts/release-local.mjs",
    "build:terminal": "node scripts/clean-build.mjs && tsc -b packages/shared packages/core-usage packages/core-llm packages/core-resource packages/core-db packages/core-rag packages/core-skills packages/core-agent packages/core-tools packages/database-capability packages/first-party-capabilities packages/agent-host apps/terminal",
    "test:terminal": "vitest run packages/agent-host apps/terminal --pool=forks --maxWorkers=1 --minWorkers=1 --testTimeout=20000 --exclude=**/tmp/** --exclude=**/.pnpm-store/**",
    "test:llm-platform": "vitest run packages/core-llm packages/agent-host apps/terminal --pool=forks --exclude=**/tmp/** --exclude=**/.pnpm-store/**",
    "test:llm-platform:contracts": "vitest run packages/core-llm/test/contracts --pool=forks --exclude=**/tmp/** --exclude=**/.pnpm-store/**",
    "test:llm-platform:entrypoints": "vitest run apps/terminal/test/cli-user-workflows.integration.test.ts --pool=forks --exclude=**/tmp/** --exclude=**/.pnpm-store/**",
    "test:llm-platform:faults": "vitest run packages/core-llm/test/fault-injection --pool=forks --exclude=**/tmp/** --exclude=**/.pnpm-store/**",
    "test:llm-platform:security": "vitest run packages/core-llm/test/security --pool=forks --exclude=**/tmp/** --exclude=**/.pnpm-store/**",
    "test:llm-platform:performance": "pnpm build:terminal && node scripts/run-llm-platform-benchmark.mjs",
    "test:database-platform": "vitest run packages/shared packages/core-resource packages/core-db packages/agent-host apps/terminal --pool=forks --exclude=**/tmp/** --exclude=**/.pnpm-store/**",
    "test:database-platform:contracts": "vitest run packages/core-resource packages/core-db/test/capability-resolver.test.ts packages/core-db/test/connector-registry.test.ts packages/core-db/test/connector-scenarios.test.ts packages/core-db/test/database-access-runtime.test.ts packages/agent-host/test/database-result-store.integration.test.ts --pool=forks --exclude=**/tmp/** --exclude=**/.pnpm-store/**",
    "test:database-platform:performance": "pnpm build:terminal && node --expose-gc scripts/run-database-access-benchmark.mjs",
    "test:public-contracts": "vitest run packages/shared --pool=forks --exclude=**/tmp/** --exclude=**/.pnpm-store/**",
    "test:public-contracts:compatibility": "vitest run packages/shared/test/contract-compatibility.test.ts --pool=forks --exclude=**/tmp/** --exclude=**/.pnpm-store/**",
    "test:public-contracts:performance": "pnpm build:terminal && node scripts/run-public-contracts-benchmark.mjs",
    "test:resource-state": "vitest run packages/core-resource --pool=forks --exclude=**/tmp/** --exclude=**/.pnpm-store/**",
    "test:resource-state:performance": "pnpm build:terminal && node --expose-gc scripts/run-resource-state-benchmark.mjs",
    "test:database-capability": "vitest run packages/core-rag packages/database-capability packages/agent-host apps/terminal --pool=forks --exclude=**/tmp/** --exclude=**/.pnpm-store/**",
    "test:database-capability:performance": "pnpm build:terminal && node --expose-gc scripts/run-schema-knowledge-benchmark.mjs",
    "test:agent-runtime:performance": "pnpm build:terminal && node --expose-gc scripts/run-agent-runtime-benchmark.mjs",
    "test:context-compaction:performance": "pnpm build:terminal && node --expose-gc scripts/run-context-compaction-benchmark.mjs",
    "test:database-capability:live": "pnpm build:terminal && node scripts/run-postgres-tests.mjs --live-llm",
    "test:context-compaction:live": "pnpm build:terminal && node scripts/run-context-compaction-live-test.mjs",
    "test:agent-runtime:live": "pnpm build:terminal && node scripts/run-general-agent-live-test.mjs",
    "test:capability-runtime": "vitest run packages/core-agent/test/capability-control-plane.test.ts packages/core-agent/test/capability-control-plane-faults.test.ts packages/core-agent/test/capability-contributions.test.ts packages/core-agent/test/tool-invocation-registry.test.ts packages/core-agent/test/tool-catalog-contract.test.ts packages/core-agent/test/tool-exposure-planner.test.ts packages/core-skills/test/capability-requirements.test.ts packages/agent-host/test/capability-runtime.integration.test.ts --pool=forks --exclude=**/tmp/** --exclude=**/.pnpm-store/** --exclude=.superpowers/**",
    "test:capability-runtime:performance": "pnpm build:terminal && node --expose-gc scripts/run-capability-control-plane-benchmark.mjs",
    "test:capability-runtime:live": "pnpm build:terminal && node scripts/run-capability-runtime-live-test.mjs",
    "test:agent-acceptance": "vitest run packages/agent-host/test/unified-agent-acceptance.integration.test.ts --pool=forks --maxWorkers=1 --minWorkers=1 --testTimeout=300000",
    "test:agent-acceptance:live": "pnpm build:terminal && node scripts/run-unified-agent-live-test.mjs --require",
    "test:script-contracts": "node --test scripts/tests/live-llm-acceptance.test.mjs scripts/tests/unified-agent-acceptance.test.mjs scripts/tests/context-compaction-live-contract.test.mjs scripts/tests/context-compaction-benchmark-contract.test.mjs scripts/tests/agent-runtime-benchmark-contract.test.mjs scripts/tests/postgres-performance-report.test.mjs",
    "test:functional:live": "pnpm build:terminal && node scripts/run-postgres-tests.mjs --live-llm",
    "test:performance:live": "pnpm build:terminal && node scripts/run-llm-live-performance.mjs",
    "model-catalog:update": "node scripts/update-model-catalog.mjs",
    "test:llm-multi-model-live": "pnpm build:terminal && node scripts/run-multi-model-tool-live-test.mjs",
    "test:llm-ollama-live": "pnpm build:terminal && node scripts/run-ollama-connection-live-test.mjs",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test --concurrency=1",
    "test:postgres": "pnpm build:terminal && node scripts/run-postgres-tests.mjs",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:script-contracts && pnpm test:llm-platform:performance && pnpm test:database-platform:performance && pnpm test:public-contracts:performance && pnpm test:resource-state:performance && pnpm test:database-capability:performance && pnpm test:context-compaction:performance && pnpm test:agent-runtime:performance",
    "db:up": "docker compose -f scripts/dev-db/docker-compose.yml up -d",
    "db:down": "docker compose -f scripts/dev-db/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
