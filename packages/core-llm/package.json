{
  "name": "@dbagent/core-llm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "package.json"],
  "scripts": {
    "build": "node ../../scripts/clean-path.mjs dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:contracts": "vitest run test/contracts --pool=forks",
    "test:entrypoints": "vitest run test/entrypoints --pool=forks",
    "test:faults": "vitest run test/fault-injection --pool=forks",
    "test:security": "vitest run test/security --pool=forks"
  },
  "dependencies": {
    "@dbagent/core-usage": "workspace:*",
    "@dbagent/shared": "workspace:*",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
