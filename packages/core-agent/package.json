{
  "name": "@dbagent/core-agent",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "package.json"],
  "scripts": {
    "build": "node ../../scripts/clean-path.mjs dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:journal": "vitest run test/agent-journal*.test.ts test/run-ingress-idempotency.test.ts test/model-turn-commit.test.ts --pool=forks"
  },
  "dependencies": {
    "@dbagent/core-llm": "workspace:*",
    "@dbagent/core-rag": "workspace:*",
    "@dbagent/core-usage": "workspace:*",
    "@dbagent/shared": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
