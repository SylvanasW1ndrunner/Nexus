{
  "name": "@dbagent/core-agent",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "package.json"],
  "scripts": {
    "build": "node ../../scripts/clean-path.mjs dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --pool=forks --maxWorkers=1 --minWorkers=1 --testTimeout=20000",
    "test:journal": "vitest run test/agent-journal*.test.ts test/run-ingress-idempotency.test.ts test/model-turn-commit.test.ts --pool=forks"
  },
  "dependencies": {
    "@dbagent/core-llm": "workspace:*",
    "@dbagent/shared": "workspace:*",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
