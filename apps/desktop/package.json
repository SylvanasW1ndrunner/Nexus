{
  "name": "@dbagent/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node ../../scripts/dev-desktop.mjs",
    "build": "tsc -p tsconfig.json && vite build --mode main && vite build --mode preload && vite build && electron-builder --dir",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "package": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@dbagent/core-auth": "workspace:*",
    "@dbagent/core-db": "workspace:*",
    "@dbagent/core-llm": "workspace:*",
    "@dbagent/core-usage": "workspace:*",
    "@dbagent/shared": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.dbagent.desktop",
    "productName": "DBAgent",
    "asar": true,
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
