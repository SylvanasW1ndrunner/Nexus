# SchemaNaut CLI (OpenAI-compatible provider example)
SCHEMANAUT_LLM_PROTOCOL=openai-chat
SCHEMANAUT_LLM_BASE_URL=https://api.siliconflow.cn/v1
SCHEMANAUT_LLM_API_KEY=<your-api-key>
SCHEMANAUT_LLM_MODEL=<your-model-id>

# Optional canonical metadata identity for relay/custom model names.
# The context window is discovered from the endpoint or bundled models.dev metadata;
# it is read-only and must not be configured manually.
# SCHEMANAUT_LLM_CANONICAL_MODEL=openai/gpt-4o

# Optional generation parameters. Omit them to use the provider/model defaults.
# SCHEMANAUT_LLM_TEMPERATURE=0.2
# SCHEMANAUT_LLM_TOP_P=0.9
# SCHEMANAUT_LLM_MAX_OUTPUT_TOKENS=4096
# SCHEMANAUT_LLM_SEED=42
# SCHEMANAUT_LLM_STOP=["<END>"]
# SCHEMANAUT_LLM_REASONING_EFFORT=medium

# PostgreSQL connection used by `schemanaut chat`
SCHEMANAUT_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/database

# Optional local state path and schema indexing limit
# SCHEMANAUT_STATE_DATABASE_PATH=.schemanaut/state.db
# SCHEMANAUT_MAX_SCHEMA_TABLES=500
